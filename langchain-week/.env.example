# Copy to .env and fill in. Never commit .env.

# Model provider key from your trainer (name depends on provider)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Model strings from your trainer
CHAT_MODEL=<provider>:<model-name>
EMBEDDING_MODEL=<provider>:<embedding-model>

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-week

# Loan Application Service API (../Loan-Application-Service, port 8000)
LOAN_API_BASE_URL=http://localhost:8000
# Officer created with scripts/create_test_officer.py (login uses the email)
LOAN_API_USERNAME=
LOAN_API_PASSWORD=
